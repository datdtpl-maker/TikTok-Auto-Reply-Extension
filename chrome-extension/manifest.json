{
  "manifest_version": 3,
  "name": "TikTok Auto-Reply Gemini AI",
  "version": "1.1.2",
  "description": "Tự động quét, tự học phong cách tư vấn của shop và trả lời Tin nhắn & Bình luận TikTok Business Suite / Hoạt động bằng Gemini API.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TikTok Auto-Reply Gemini AI"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "content/dom-utils.js",
        "content/adaptive-dom.js",
        "content/business-suite.js",
        "content/tiktok-activity.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
